API_PORT=4010
VITE_API_BASE_URL=http://localhost:4010
CONGRESS_GOV_API_KEY=DEMO_KEY

# Required before scheduled Senate eFD collection starts.
SENATE_EFD_ACKNOWLEDGE_USE_RESTRICTIONS=false

# Automatic PTR collector. Leave disabled for manual-only operation.
TRACKER_AUTO_COLLECT_ENABLED=false
TRACKER_POLL_INTERVAL_MINUTES=60
TRACKER_SEARCH_LOOKBACK_DAYS=45
TRACKER_SEARCH_PAGE_LENGTH=25
TRACKER_MAX_IMPORTS_PER_RUN=10
